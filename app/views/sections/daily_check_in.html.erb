<div><h2><%= @section.name %> Daily Check-In</h2></div>

<% if params[:saved_entry_id].present? %>
  <script>
    (function() {
      function clearSavedIndicator() {
        var indicator = document.querySelector('.saved-indicator-row');
        if (!indicator) return;

        window.setTimeout(function() {
          indicator.style.opacity = '0';
        }, 700);

        window.setTimeout(function() {
          indicator.remove();
        }, 1100);

        if (window.history && window.history.replaceState) {
          var url = new URL(window.location.href);
          url.searchParams.delete('saved_entry_id');
          window.history.replaceState({}, '', url.toString());
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', clearSavedIndicator);
      } else {
        clearSavedIndicator();
      }
    })();
  </script>
<% end %>

<p>
  <strong>Date:</strong> <%= @school_day.date.strftime('%A, %b %-d, %Y') %><br>
  <strong>Day:</strong> <%= @school_day.day_name %><br>
  <strong>Section Entries:</strong> <%= @attendance_entries.size %>
</p>

<% if @attendance_entries.any? %>
  <% not_yet_reported_entries = @attendance_entries.select { |entry| entry.status == 'not_yet_reported' } %>
  <% reported_entries = @attendance_entries.reject { |entry| entry.status == 'not_yet_reported' } %>

  <table class="table table-hover">
    <thead>
      <tr>
        <th>Student</th>
        <th>Grade</th>
        <th>Status</th>
        <th>Notes</th>
        <th>Attendance Update</th>
      </tr>
    </thead>
    <tbody>
      <% if not_yet_reported_entries.any? %>
        <tr>
          <td colspan="5"><strong>Not Yet Reported</strong></td>
        </tr>
      <% end %>

      <% not_yet_reported_entries.each do |entry| %>
        <% attendance_notice = @attendance_notices_by_student_id[entry.student_id] %>
        <tr>
          <td><%= entry.student.full_name %></td>
          <td><%= entry.student.grade %></td>
          <td><%= entry.status.humanize %></td>
          <td><%= attendance_notice&.notes %></td>
          <td>
            <%= form_with url: teacher_section_update_daily_check_in_path(teacher_id: @teacher.id, section_id: @section.id), method: :patch, local: true do %>
              <%= hidden_field_tag :entry_id, entry.id %>
              <% AttendanceEntry::STATUSES.each do |status| %>
                <label style="margin-right: 8px; white-space: nowrap;">
                  <%= radio_button_tag :status, status, entry.status == status, onchange: 'this.form.requestSubmit()' %>
                  <%= status.humanize %>
                </label>
              <% end %>
              <% if params[:saved_entry_id].to_s == entry.id.to_s %>
                <span class="saved-indicator-row" style="font-size: 11px; color: #777; margin-left: 8px; transition: opacity 0.35s ease;">Saved</span>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>

      <% if reported_entries.any? %>
        <tr>
          <td colspan="5"><strong>Reported</strong></td>
        </tr>
      <% end %>

      <% reported_entries.each do |entry| %>
        <% attendance_notice = @attendance_notices_by_student_id[entry.student_id] %>
        <tr>
          <td><%= entry.student.full_name %></td>
          <td><%= entry.student.grade %></td>
          <td><%= entry.status.humanize %></td>
          <td><%= attendance_notice&.notes %></td>
          <td>
            <%= form_with url: teacher_section_update_daily_check_in_path(teacher_id: @teacher.id, section_id: @section.id), method: :patch, local: true do %>
              <%= hidden_field_tag :entry_id, entry.id %>
              <% AttendanceEntry::STATUSES.each do |status| %>
                <label style="margin-right: 8px; white-space: nowrap;">
                  <%= radio_button_tag :status, status, entry.status == status, onchange: 'this.form.requestSubmit()' %>
                  <%= status.humanize %>
                </label>
              <% end %>
              <% if params[:saved_entry_id].to_s == entry.id.to_s %>
                <span class="saved-indicator-row" style="font-size: 11px; color: #777; margin-left: 8px; transition: opacity 0.35s ease;">Saved</span>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No attendance entries were found for students in this section for today.</p>
<% end %>
